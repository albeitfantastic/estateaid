{
  "expo": {
    "name": "Maison",
    "slug": "EstateAid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo_1426.png",
    "scheme": "estateaid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.estateaid.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.estateaid.app",
      "adaptiveIcon": {
        "foregroundImage": "./logo_1426.png",
        "backgroundColor": "#FAFAF8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo_1426.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./logo_1426.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E8",
          "dark": {
            "backgroundColor": "#0F1F1E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9e163c-b8ad-49af-8134-473a6b223323"
      }
    },
    "owner": "albeit"
  }
}
