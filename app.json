{
  "expo": {
    "name": "Maison",
    "slug": "maison",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo_1426.png",
    "scheme": "maison",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.estateaid.app",
      "associatedDomains": [
        "applinks:maison.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tg",
          "sms"
        ],
        "NSCalendarsUsageDescription": "Maison adds stays and property events to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Maison adds stays and property events to your calendar.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Maison adds stays and property events to your calendar."
      }
    },
    "android": {
      "package": "com.maison.app",
      "adaptiveIcon": {
        "foregroundImage": "./logo_1426.png",
        "backgroundColor": "#FAFAF8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "queries": [
        {
          "scheme": "whatsapp"
        },
        {
          "scheme": "tg"
        },
        {
          "scheme": "sms"
        }
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "maison.app",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo_1426.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Maison adds stays and property events to your calendar."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./logo_1426.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E8",
          "dark": {
            "backgroundColor": "#0F1F1E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e5f5df9-ffa9-4705-99c4-50bd25278aa7"
      }
    },
    "owner": "albeit"
  }
}
