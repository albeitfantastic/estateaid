# -----------------------------------------------------------------------------
# Copy to .env.local for local dev. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Client-safe (Expo: EXPO_PUBLIC_* is embedded in the app bundle) ---------
# Supabase anon key only — never the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat: use ONE of the following patterns (public SDK keys only — not secret).

# Option A — Single key (Test Store / some unified test keys work for both platforms):
EXPO_PUBLIC_REVENUECAT_API_KEY=test_YOUR_PUBLIC_SDK_KEY

# Option B — Platform-specific (production / standard SDK keys from RevenueCat → API keys):
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_IOS_PUBLIC_KEY
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_ANDROID_PUBLIC_KEY

# Entitlement identifier — must match RevenueCat dashboard Identifier exactly (default: "Maison Pro").
EXPO_PUBLIC_RC_ENTITLEMENT_ID=Maison Pro

# Optional. Google Places Autocomplete. Restrict the key to Places API.
# Without it, location search uses public map geocoding.
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=YOUR_BROWSER_OR_APP_KEY

# -----------------------------------------------------------------------------
# Server-only (Supabase Edge Function secrets — NOT in Expo)
# Set via: supabase secrets set KEY=value
#
# REVENUECAT_WEBHOOK_SECRET   Long random string; same value as Authorization
#                              Bearer token configured in RevenueCat webhook URL.
# SUPABASE_SERVICE_ROLE_KEY   Injected automatically on hosted Edge Functions;
#                              required for local `supabase functions serve` tests.
# SUPABASE_URL                Injected automatically when deployed.
# -----------------------------------------------------------------------------
